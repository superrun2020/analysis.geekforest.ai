[Unit]
Description=JKCL aggregate previous-day funnel DWS tables
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/jkcl-funnel-api/current
Environment=PLUGIN_INITIALIZATION_ENABLED=false
ExecStart=/bin/bash -lc '/usr/bin/php artisan funnel-analysis:aggregate --start-date="$(date -d yesterday +%%F)" --end-date="$(date -d yesterday +%%F)" --force --no-interaction'
ExecStartPost=/bin/bash -lc '/usr/bin/php artisan funnel-analysis:warm-workbench-cache --date="$(date -d yesterday +%%F)" --domain=all --platform=android --limit=200 --force --no-interaction'
TimeoutStartSec=14400
Restart=on-failure
RestartSec=30min
StandardOutput=journal
StandardError=journal
