[Unit]
Description=Backfill JKCL session-scope aggregates for all projects over previous 7 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/jkcl-funnel-api/current
Environment=PLUGIN_INITIALIZATION_ENABLED=false
ExecStart=/bin/bash -lc '/usr/bin/php artisan funnel-analysis:aggregate --start-date="$(date -d "7 days ago" +%%F)" --end-date="$(date -d yesterday +%%F)" --force --no-interaction'
ExecStartPost=/bin/bash -lc '/usr/bin/php artisan cache:clear; for offset in 7 6 5 4 3 2 1; do day="$(date -d "$offset days ago" +%%F)"; /usr/bin/php artisan funnel-analysis:warm-workbench-cache --date="$day" --domain=all --platform=android --limit=200 --no-interaction || true; done'
TimeoutStartSec=43200
StandardOutput=journal
StandardError=journal
